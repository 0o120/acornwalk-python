from collections.abc import Callable, Mapping
from typing import Any, Protocol

class VisitorTable(Protocol):
    def __getitem__(self, kind: str) -> Callable[..., Any]: ...

class Found:
    @property
    def node(self) -> Any: ...
    @property
    def state(self) -> Any: ...
    def __init__(self, node: Any, state: Any) -> None: ...

class Base:
    def __getitem__(self, kind: str) -> Callable[..., Any]: ...

def getField(node: Any, name: str, default: Any = None) -> Any: ...
def nodeRange(node: Any) -> tuple[int, int]: ...
def simple(node: Any, visitors: Mapping[str, Callable[..., Any]], baseVisitor: VisitorTable | None = None, state: Any = None, override: str | None = None) -> None: ...
def ancestor(node: Any, visitors: Mapping[str, Callable[..., Any]], baseVisitor: VisitorTable | None = None, state: Any = None, override: str | None = None) -> None: ...
def recursive(node: Any, state: Any, funcs: Mapping[str, Callable[..., Any]] | None, baseVisitor: VisitorTable | None = None, override: str | None = None) -> None: ...
def full(node: Any, callback: Callable[..., Any], baseVisitor: VisitorTable | None = None, state: Any = None, override: str | None = None) -> None: ...
def fullAncestor(node: Any, callback: Callable[..., Any], baseVisitor: VisitorTable | None = None, state: Any = None, override: str | None = None) -> None: ...
def make(funcs: Mapping[str, Callable[..., Any]], baseVisitor: VisitorTable | None = None) -> VisitorTable: ...
def findNodeAt(node: Any, start: int | None, end: int | None, test: str | Callable[[str, Any], bool] | None = None, baseVisitor: VisitorTable | None = None, state: Any = None) -> Found | None: ...
def findNodeAround(node: Any, pos: int, test: str | Callable[[str, Any], bool] | None = None, baseVisitor: VisitorTable | None = None, state: Any = None) -> Found | None: ...
def findNodeAfter(node: Any, pos: int, test: str | Callable[[str, Any], bool] | None = None, baseVisitor: VisitorTable | None = None, state: Any = None) -> Found | None: ...
def findNodeBefore(node: Any, pos: int, test: str | Callable[[str, Any], bool] | None = None, baseVisitor: VisitorTable | None = None, state: Any = None) -> Found | None: ...
